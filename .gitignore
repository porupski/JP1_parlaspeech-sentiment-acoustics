# Rule of thumb: shipped-empty folders keep their `.gitkeep` marker; everything
# else in them is generated and MUST NOT be committed.
#
# The pattern `folder/*` + `!folder/.gitkeep` (or similar) is what makes
# an empty directory itself trackable but its contents ignored.

# ─── data (raw + intermediate; large, not committed) ────────────────
data/geo/
data/intermediate/
data/lexicons/
data/sample/

# ─── generated pipeline outputs (results/) ──────────────────────────
# Keep the results/ directory itself (via .gitkeep) but ignore everything in it.
results/*
!results/.gitkeep
results-final/
results-*/

# ─── local runtime / scratch dirs ───────────────────────────────────
logs/*
!logs/.gitkeep
misc/*
!misc/.gitkeep

# ─── testing / archive (kept, but their outputs and caches aren't) ──
tests/__pycache__/
tests/.pytest_cache/
archive/

# ─── jupytext-generated notebooks (source is the .py file) ──────────
#*.ipynb

# ─── Python bytecode + build artifacts ──────────────────────────────
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── editors / OS ───────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*.iml

# ─── LaTeX build artefacts (paper/ now lives outside repo, but just in case) ──
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
